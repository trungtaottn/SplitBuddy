{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                session_id,\n                description,\n                amount,\n                COALESCE(amount_original, amount) as \"amount_original!\",\n                currency_code,\n                exchange_rate,\n                rate_source,\n                rate_timestamp,\n                split_strategy,\n                created_by,\n                created_at\n            FROM bills\n            WHERE session_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
