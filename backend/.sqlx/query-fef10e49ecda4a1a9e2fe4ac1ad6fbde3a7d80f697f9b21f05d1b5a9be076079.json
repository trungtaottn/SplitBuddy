{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                sp.id,\n                sp.user_id,\n                sp.guest_name,\n                COALESCE(u.full_name, sp.guest_name, 'Unknown') as \"display_name!\",\n                sp.role as \"role: ParticipantRole\",\n                sp.joined_at\n            FROM session_participants sp\n            LEFT JOIN users u ON sp.user_id = u.id\n            WHERE sp.session_id = $1\n            ORDER BY sp.joined_at\n            ",
