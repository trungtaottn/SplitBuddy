{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                gm.id,\n                gm.user_id,\n                u.full_name,\n                u.email,\n                u.avatar_url,\n                gm.role,\n                gm.joined_at\n            FROM group_members gm\n            INNER JOIN users u ON gm.user_id = u.id\n            WHERE gm.group_id = $1\n            ORDER BY gm.joined_at\n            ",
