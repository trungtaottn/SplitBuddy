  "query": "\n            SELECT id, game_type, content_type, content, difficulty\n            FROM game_content\n            WHERE game_type = 'challenge' AND is_active = true \n              AND (difficulty IS NULL OR difficulty != '18+')\n            ORDER BY RANDOM()\n            LIMIT 1\n            ",
