{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT g.id, g.name, g.description, g.created_by, g.created_at, g.archived_at\n            FROM groups g\n            INNER JOIN group_members gm ON g.id = gm.group_id\n            WHERE gm.user_id = $1\n              AND ($2::bool OR g.archived_at IS NULL)\n            ORDER BY g.created_at DESC\n            ",
