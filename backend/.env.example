# Database
DATABASE_URL=postgres://splitbuddy:splitbuddy@localhost:5432/splitbuddy

# Redis (optional - for WebSocket scaling and caching)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Server
HOST=127.0.0.1
PORT=8080

# Security - CHANGE THESE IN PRODUCTION!
ADMIN_DEFAULT_PASSWORD=Admin123!Secure
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30

# Recurring scheduler
RECURRING_EXPENSE_SCHEDULER_INTERVAL_SECONDS=300
RECURRING_EXPENSE_SCHEDULER_JITTER_PERCENT=10

# Push Notifications (VAPID_PRIVATE_KEY required in production)
VAPID_PRIVATE_KEY=your-base64-encoded-private-key
VAPID_SUBJECT=mailto:admin@splitbuddy.com

# Environment
RUST_LOG=debug,sqlx=warn
