#!/bin/bash
# SplitBuddy Pre-commit Hook
# Tự động format code trước khi commit và chạy checks

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Running pre-commit checks...${NC}"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if backend files are staged
BACKEND_CHANGED=$(echo "$STAGED_FILES" | grep -E "^backend/" || true)
FRONTEND_CHANGED=$(echo "$STAGED_FILES" | grep -E "^frontend/" || true)

# ============================================
# Backend: Auto-format with cargo fmt
# ============================================
if [ -n "$BACKEND_CHANGED" ]; then
    echo -e "${YELLOW}📦 Backend files changed - Running cargo fmt...${NC}"
    
    cd backend
    
    # Auto-format Rust code
    cargo fmt 2>/dev/null || {
        echo -e "${RED}❌ cargo fmt failed. Please check your Rust installation.${NC}"
        exit 1
    }
    
    # Re-add formatted files
    FORMATTED_RS_FILES=$(echo "$BACKEND_CHANGED" | grep -E "\.rs$" || true)
    if [ -n "$FORMATTED_RS_FILES" ]; then
        cd ..
        echo "$FORMATTED_RS_FILES" | xargs git add
        cd backend
        echo -e "${GREEN}✅ Rust files auto-formatted and staged${NC}"
    fi
    
    # Run clippy check
    echo -e "${YELLOW}🔍 Running clippy...${NC}"
    cargo clippy --release -- -D warnings 2>&1 || {
        echo -e "${RED}❌ Clippy found issues. Please fix them before committing.${NC}"
        exit 1
    }
    echo -e "${GREEN}✅ Clippy passed${NC}"
    
    cd ..
fi

# ============================================
# Frontend: Auto-fix with ESLint
# ============================================
if [ -n "$FRONTEND_CHANGED" ]; then
    echo -e "${YELLOW}📦 Frontend files changed - Running ESLint fix...${NC}"
    
    cd frontend
    
    # Get only TS/TSX files
    TS_FILES=$(echo "$FRONTEND_CHANGED" | grep -E "\.(ts|tsx)$" | sed 's|^frontend/||' || true)
    
    if [ -n "$TS_FILES" ]; then
        # Auto-fix ESLint issues (suppress output, only show errors)
        echo "$TS_FILES" | xargs npx eslint --fix --quiet 2>/dev/null || true
        
        # Re-add fixed files
        cd ..
        echo "$FRONTEND_CHANGED" | grep -E "\.(ts|tsx)$" | xargs git add 2>/dev/null || true
        cd frontend
        echo -e "${GREEN}✅ TypeScript files auto-fixed and staged${NC}"
    fi
    
    # Run type check (quick, non-blocking)
    echo -e "${YELLOW}🔍 Running TypeScript type check...${NC}"
    npm run type-check 2>&1 | tail -5 || {
        echo -e "${YELLOW}⚠️ TypeScript has type errors (non-blocking)${NC}"
    }
    
    # Update version.json before build (only if on dev branch)
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [ "$CURRENT_BRANCH" = "dev" ]; then
        echo -e "${YELLOW}📝 Updating version.json for dev branch...${NC}"
        node scripts/update-version.js 2>/dev/null || true
        # Stage version.json if it was updated
        if [ -f "public/version.json" ]; then
            cd ..
            git add frontend/public/version.json 2>/dev/null || true
            cd frontend
            echo -e "${GREEN}✅ Version updated and staged${NC}"
        fi
    fi
    
    # Check build (important)
    echo -e "${YELLOW}🔨 Checking frontend build...${NC}"
    npm run build 2>&1 | tail -10 || {
        echo -e "${RED}❌ Frontend build failed. Please fix errors before committing.${NC}"
        exit 1
    }
    echo -e "${GREEN}✅ Frontend build passed${NC}"
    
    cd ..
fi

# ============================================
# Final summary
# ============================================
echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo -e "${BLUE}📝 Committing...${NC}"
